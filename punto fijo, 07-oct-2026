        "def p_fijo(p0, i):\n",
        "    lista=[]\n",
        "    error=[]\n",
        "\n",
        "    for i in range(i):\n",
        "        p1=g(p0)\n",
        "        lista.append(p1)\n",
        "        e=np.abs(p1-p0)\n",
        "        error.append(abs(e))\n",
        "        p0=p1\n",
        "    return lista,error"
